# Application Deployment Configuration
NODE_ENV=production

# Custom Subdomain Configuration (e.g. appname.domainname.com)
DOMAIN_NAME=appname.domainname.com

# ACM Certificate ARN in us-east-1 for *.domainname.com
ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

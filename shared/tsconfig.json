{
  "extends": "../tsconfig.base.json",

  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "src",
    "outDir": "dist",

    "declaration": true,
    "declarationMap": true,

    "noEmit": false
  },

  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}

# Backend Runtime Configuration & Local Prisma Commands
NODE_ENV=development
PORT=3000

# CORS Configuration (Allowed frontend origin or comma-separated origins)
CORS_ORIGIN=http://appname.myapp.test:5173

# Central Authentication Service Configuration
# Shared JWT secret (or public key) matching the central auth service
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_long

# Database Configuration (PostgreSQL)
# Replace {project_template} with your app schema name
DATABASE_URL=postgresql://user:password@localhost:5432/postgres?schema={project_template}

# AWS / S3 Configuration
AWS_REGION=us-east-1
S3_BUCKET=my-app-bucket
